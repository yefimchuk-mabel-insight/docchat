# Answers: set ONE of these to use an LLM. With none, the offline extractive mode is used.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional: force the answer provider when several keys are set (anthropic | openai | gemini)
LLM_PROVIDER=

# Semantic search: enabled automatically when an OpenAI or Gemini key is present.
# Set to "off" to use BM25 only.
EMBEDDINGS=

# Optional model overrides
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_MODEL=gpt-4.1-mini
GEMINI_MODEL=gemini-2.5-flash
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

PORT=3000
